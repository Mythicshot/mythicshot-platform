{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "@cloudflare/vitest-plugin/types"
    ],
    "paths": {
      "#harness": [
        "./test/harness.cloudflare.ts"
      ]
    }
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "src/node/**",
    "src/player/main.ts",
    "src/player/vendor/**",
    "src/docs/client/**",
    "test/node-*.test.ts",
    "scripts/**",
    "test/harness.node.ts",
    "test/node-admin-page.ts",
    "test/node-tours-page.ts",
    "node_modules",
    "dist"
  ]
}

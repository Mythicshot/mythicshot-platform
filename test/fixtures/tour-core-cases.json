{
  "about": "Shared cases for tour_core.js and the Rust rules in tour/core.rs (place, zoom, bold) and tour/doc.rs (safe_url, clean, hex_colour). Both implementations must give these answers. Sizes and positions are image pixels. Non-finite numbers are written as the strings \"NaN\", \"Infinity\" and \"-Infinity\".",
  "place": [
    {"name": "place 1", "image": [800, 500], "card": [260, 120], "avoid": [300, 100, 500, 160], "placement": "auto", "expect": {"x": 270, "y": 172, "side": "bottom"}},
    {"name": "place 2", "image": [800, 500], "card": [260, 120], "avoid": [300, 400, 500, 480], "placement": "auto", "expect": {"x": 270, "y": 268, "side": "top"}},
    {"name": "place 3", "image": [800, 500], "card": [260, 120], "avoid": [10, 10, 790, 490], "placement": "auto", "expect": {"x": 0, "y": 500, "side": "docked"}},
    {"name": "place 4", "image": [800, 500], "card": [260, 120], "avoid": null, "placement": "auto", "expect": {"x": 270, "y": 364, "side": "none"}},
    {"name": "place 5", "image": [800, 500], "card": [260, 120], "avoid": [700, 200, 790, 260], "placement": "auto", "expect": {"x": 532, "y": 272, "side": "bottom"}},
    {"name": "place 6", "image": [800, 500], "card": [260, 120], "avoid": [300, 100, 500, 160], "placement": "left", "expect": {"x": 28, "y": 70, "side": "left"}},
    {"name": "place 7: bottom and top do not fit, right does", "image": [800, 500], "card": [260, 120], "avoid": [10, 100, 100, 400], "placement": "auto", "expect": {"x": 112, "y": 190, "side": "right"}},
    {"name": "place 8: the asked side does not fit, so the order is tried", "image": [800, 500], "card": [260, 120], "avoid": [300, 100, 500, 160], "placement": "top", "expect": {"x": 270, "y": 172, "side": "bottom"}},
    {"name": "place 9: a box dragged backwards is the same box", "image": [800, 500], "card": [260, 120], "avoid": [500, 160, 300, 100], "placement": "auto", "expect": {"x": 270, "y": 172, "side": "bottom"}},
    {"name": "place 10: right asked and fits", "image": [800, 500], "card": [260, 120], "avoid": [300, 200, 400, 300], "placement": "right", "expect": {"x": 412, "y": 190, "side": "right"}},
    {"name": "phone 1: portrait phone, room below", "image": [320, 568], "card": [240, 100], "avoid": [100, 200, 220, 260], "placement": "auto", "expect": {"x": 40, "y": 272, "side": "bottom"}},
    {"name": "phone 2: the asked side does not fit on a small image", "image": [320, 568], "card": [240, 100], "avoid": [100, 200, 220, 260], "placement": "left", "expect": {"x": 40, "y": 272, "side": "bottom"}},
    {"name": "phone 3: landscape phone, the card is larger than every free side", "image": [320, 180], "card": [240, 100], "avoid": [100, 60, 220, 120], "placement": "auto", "expect": {"x": 0, "y": 180, "side": "docked"}},
    {"name": "phone 4: a card wider than the image docks", "image": [320, 180], "card": [400, 100], "avoid": [10, 10, 20, 20], "placement": "auto", "expect": {"x": 0, "y": 180, "side": "docked"}},
    {"name": "edge 1: spotlight on the top edge", "image": [800, 500], "card": [260, 120], "avoid": [300, 0, 500, 40], "placement": "auto", "expect": {"x": 270, "y": 52, "side": "bottom"}},
    {"name": "edge 2: spotlight on the bottom edge", "image": [800, 500], "card": [260, 120], "avoid": [300, 460, 500, 500], "placement": "auto", "expect": {"x": 270, "y": 328, "side": "top"}},
    {"name": "edge 3: tall spotlight on the left edge", "image": [800, 500], "card": [260, 120], "avoid": [0, 50, 60, 450], "placement": "auto", "expect": {"x": 72, "y": 190, "side": "right"}},
    {"name": "edge 4: tall spotlight on the right edge", "image": [800, 500], "card": [260, 120], "avoid": [740, 50, 800, 450], "placement": "auto", "expect": {"x": 468, "y": 190, "side": "left"}},
    {"name": "edge 5: spotlight in the bottom right corner", "image": [800, 500], "card": [260, 120], "avoid": [700, 420, 800, 500], "placement": "auto", "expect": {"x": 532, "y": 288, "side": "top"}},
    {"name": "tie: a fit within 0.001 px counts in both languages", "image": [800, 500], "card": [260, 120], "avoid": [300, 100, 500, 360.00001], "placement": "bottom", "expect": {"x": 270, "y": 372.00001, "side": "bottom"}},
    {"name": "non-finite 1: NaN in the box docks the card", "image": [800, 500], "card": [260, 120], "avoid": ["NaN", 100, 500, 160], "placement": "auto", "expect": {"x": 0, "y": 500, "side": "docked"}},
    {"name": "non-finite 2: Infinity in the box docks the card", "image": [800, 500], "card": [260, 120], "avoid": [300, 100, 500, "Infinity"], "placement": "auto", "expect": {"x": 0, "y": 500, "side": "docked"}}
  ],
  "zoom": [
    {"name": "zoom 1", "view": [800, 500], "focus": [400, 250], "k": 1.18, "expect": {"tx": -72, "ty": -45}},
    {"name": "zoom 2", "view": [800, 500], "focus": [800, 500], "k": 1.18, "expect": {"tx": -144, "ty": -90}},
    {"name": "zoom 3", "view": [800, 500], "focus": [0, 0], "k": 1.18, "expect": {"tx": 0, "ty": 0}},
    {"name": "zoom 3: any focus with k 1", "view": [800, 500], "focus": [123, 456], "k": 1, "expect": {"tx": 0, "ty": 0}},
    {"name": "zoom 4: focus off the image edge still shows nothing outside", "view": [800, 500], "focus": [-50, 900], "k": 1.4, "expect": {"tx": 0, "ty": -200}},
    {"name": "zoom 5: the smallest zoom, 1.05", "view": [800, 500], "focus": [400, 250], "k": 1.05, "expect": {"tx": -20, "ty": -12.5}},
    {"name": "zoom 6: the largest zoom, 1.4, clamped at the far edges", "view": [800, 500], "focus": [600, 400], "k": 1.4, "expect": {"tx": -320, "ty": -200}},
    {"name": "zoom 7: phone, 1.4 around the centre", "view": [320, 568], "focus": [160, 284], "k": 1.4, "expect": {"tx": -64, "ty": -113.6}},
    {"name": "non-finite 1: NaN focus means no zoom", "view": [320, 568], "focus": ["NaN", 100], "k": 1.4, "expect": {"tx": 0, "ty": 0}},
    {"name": "non-finite 2: an infinite k means no zoom", "view": [320, 568], "focus": [160, 284], "k": "Infinity", "expect": {"tx": 0, "ty": 0}},
    {"name": "non-finite 3: an infinite view means no zoom", "view": ["-Infinity", 568], "focus": [160, 284], "k": 1.4, "expect": {"tx": 0, "ty": 0}}
  ],
  "bold": [
    {"name": "bold 1", "text": "a **b** c", "expect": [["a ", false], ["b", true], [" c", false]]},
    {"name": "bold 2", "text": "**x", "expect": [["**x", false]]},
    {"name": "bold 3", "text": "", "expect": []},
    {"name": "bold 4: a pair then an unpaired marker", "text": "a **b** c **d", "expect": [["a ", false], ["b", true], [" c **d", false]]},
    {"name": "bold 5: empty pieces are dropped", "text": "****x**", "expect": [["x**", false]]},
    {"name": "bold 6: line breaks are kept, CRLF and CR become LF", "text": "one\r\n**two**\rthree", "expect": [["one\n", false], ["two", true], ["\nthree", false]]},
    {"name": "bold 7: markup is just characters", "text": "**</script><img src=x onerror=alert(1)>**", "expect": [["</script><img src=x onerror=alert(1)>", true]]}
  ],

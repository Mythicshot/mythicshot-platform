{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demo-platform",
  "main": "src/cloudflare/entry.ts",
  "compatibility_date": "2026-11-17",
  // Placeholders: an install sets its own database id and bucket names (in wrangler.deploy.jsonc).
  // SETUP_CODE is a secret (`wrangler secret put SETUP_CODE`, or .dev.vars locally), never a var.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "demo-platform",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "DRAFTS", "bucket_name": "demo-platform-drafts" },
    { "binding": "PUB", "bucket_name": "demo-platform-public" }
  ],
  "vars": {
    // PUBLIC_IMAGE_BASE: empty (the default): the app serves published images itself on
    // /p/<name>, through the PUB binding, on Workers exactly as locally; the bucket then
    // needs no public access. Optionally, the https origin of the public bucket's own
    // custom domain, for heavier use. The page reads it at render time.
    //
    // ONLY WHEN SET: the bucket's custom domain answers with whatever headers the zone
    // gives it, and the app cannot set them. The install must then add a response-header
    // transform rule on that custom domain that sets
    //   X-Content-Type-Options: nosniff
    //   Content-Security-Policy: default-src 'none'; sandbox
    // on every response, matching what the app sends on /p/<name>. The Cloudflare runbook
    // carries this as an optional step.
    //
    // `npm run setup:cloudflare` writes each install's copy of this file to
    // wrangler.deploy.jsonc (ignored by Git), with its own names, database id and address.
    "PUBLIC_IMAGE_BASE": "",
    // TOURS_HOST and APP_HOST: both empty (the default): the app serves one address and
    // checks no host name. Both set, as host names such as tours.example.com and
    // app.example.com: tour pages and their pictures are served on the tours address
    // only, the token API on both, and every other host name, the workers.dev address
    // included, gets an empty 421. One without the other, a value that is not a host
    // name, or the same name twice: every request answers 500 `misconfigured`, /healthz
    // included, until the pair is fixed or emptied.
    //
    // `npm run setup:cloudflare` sets up one address: it writes both empty on a new install,
    // and keeps what an install's own file (wrangler.deploy.jsonc) holds, as it is.
    "TOURS_HOST": "",
    "APP_HOST": ""
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "demo-platform",
  "main": "src/cloudflare/entry.ts",
  "compatibility_date": "2026-11-17",
  // Placeholders: an install sets its own database id and bucket names.
  // SETUP_CODE is a secret (`wrangler secret put SETUP_CODE`, or .dev.vars locally), never a var.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "demo-platform",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "DRAFTS", "bucket_name": "demo-platform-drafts" },
    { "binding": "PUB", "bucket_name": "demo-platform-public" }
  ],
  "vars": {
    // PUBLIC_IMAGE_BASE: the https origin of the public bucket's custom domain (empty: the
    // app serves published images itself on /p/<name>). The page reads it at render time.
    //
    // REQUIRED ON CLOUDFLARE, NOT SET BY THE APP: the bucket's custom domain answers with
    // whatever headers the zone gives it, and the app cannot set them. The install must add
    // a response-header transform rule on that custom domain that sets
    //   X-Content-Type-Options: nosniff
    //   Content-Security-Policy: default-src 'none'; sandbox
    // on every response, matching what the app sends on /p/<name>. The Cloudflare runbook
    // and the deploy task must carry this step.
    "PUBLIC_IMAGE_BASE": ""
  }
}

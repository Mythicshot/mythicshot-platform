{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "#harness": [
        "./test/harness.node.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "vitest.node.config.ts"
  ],
  "exclude": [
    "src/cloudflare/**",
    "src/player/main.ts",
    "src/player/vendor/**",
    "test/harness.cloudflare.ts",
    "node_modules",
    "dist"
  ]
}
